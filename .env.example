# Configuración de Supabase (rellena con los valores de tu proyecto).
# Las variables VITE_ se exponen en el cliente; la anon/publishable key es pública por diseño.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
